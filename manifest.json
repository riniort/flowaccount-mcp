{
  "manifest_version": "0.2",
  "name": "flowaccount",
  "version": "1.0.0",
  "display_name": "FlowAccount",
  "description": "MCP server for FlowAccount Thai accounting platform - จัดการเอกสารบัญชี ใบกำกับภาษี ใบเสร็จรับเงิน ใบเสนอราคา ค่าใช้จ่าย และอื่นๆ",
  "author": {
    "name": "Tod Sawatt"
  },
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "FLOWACCOUNT_CULTURE": "${user_config.culture}",
        "FLOWACCOUNT_HEADLESS": "${user_config.headless}"
      }
    }
  },
  "user_config": {
    "culture": {
      "type": "string",
      "title": "Language / ภาษา",
      "description": "Language code: th (ไทย), en (English)",
      "default": "th",
      "required": false
    },
    "headless": {
      "type": "string",
      "title": "Headless Browser",
      "description": "Run authentication browser in headless mode (true/false)",
      "default": "false",
      "required": false
    }
  },
  "tools": [
    { "name": "list_contacts", "description": "List all contacts with optional search" },
    { "name": "get_contact", "description": "Get a single contact by ID" },
    { "name": "create_contact", "description": "Create a new contact" },
    { "name": "update_contact", "description": "Update an existing contact" },
    { "name": "delete_contact", "description": "Delete a contact" },
    { "name": "list_products", "description": "List products/services" },
    { "name": "get_product", "description": "Get a single product by ID" },
    { "name": "create_product", "description": "Create a new product" },
    { "name": "update_product", "description": "Update a product" },
    { "name": "delete_product", "description": "Delete a product" },
    { "name": "list_quotations", "description": "List quotation documents (ใบเสนอราคา)" },
    { "name": "get_quotation", "description": "Get a single quotation" },
    { "name": "create_quotation", "description": "Create a new quotation" },
    { "name": "update_quotation", "description": "Update a quotation" },
    { "name": "delete_quotation", "description": "Delete a quotation" },
    { "name": "change_quotation_status", "description": "Change quotation status" },
    { "name": "list_tax_invoices", "description": "List tax invoice documents (ใบกำกับภาษี)" },
    { "name": "get_tax_invoice", "description": "Get a single tax invoice" },
    { "name": "create_tax_invoice", "description": "Create a new tax invoice" },
    { "name": "update_tax_invoice", "description": "Update a tax invoice" },
    { "name": "delete_tax_invoice", "description": "Delete a tax invoice" },
    { "name": "record_tax_invoice_payment", "description": "Record payment on a tax invoice" },
    { "name": "list_receipts", "description": "List receipt documents (ใบเสร็จรับเงิน)" },
    { "name": "get_receipt", "description": "Get a single receipt" },
    { "name": "create_receipt", "description": "Create a new receipt" },
    { "name": "update_receipt", "description": "Update a receipt" },
    { "name": "delete_receipt", "description": "Delete a receipt" },
    { "name": "record_receipt_payment", "description": "Record payment on a receipt" },
    { "name": "list_billing_notes", "description": "List billing note documents (ใบวางบิล)" },
    { "name": "get_billing_note", "description": "Get a single billing note" },
    { "name": "create_billing_note", "description": "Create a new billing note" },
    { "name": "update_billing_note", "description": "Update a billing note" },
    { "name": "delete_billing_note", "description": "Delete a billing note" },
    { "name": "record_billing_note_payment", "description": "Record payment on a billing note" },
    { "name": "list_cash_invoices", "description": "List cash invoice documents (บิลเงินสด)" },
    { "name": "get_cash_invoice", "description": "Get a single cash invoice" },
    { "name": "create_cash_invoice", "description": "Create a new cash invoice" },
    { "name": "update_cash_invoice", "description": "Update a cash invoice" },
    { "name": "delete_cash_invoice", "description": "Delete a cash invoice" },
    { "name": "record_cash_invoice_payment", "description": "Record payment on a cash invoice" },
    { "name": "list_purchase_orders", "description": "List purchase order documents (ใบสั่งซื้อ)" },
    { "name": "get_purchase_order", "description": "Get a single purchase order" },
    { "name": "create_purchase_order", "description": "Create a new purchase order" },
    { "name": "update_purchase_order", "description": "Update a purchase order" },
    { "name": "delete_purchase_order", "description": "Delete a purchase order" },
    { "name": "list_expenses", "description": "List expense documents (ค่าใช้จ่าย)" },
    { "name": "get_expense", "description": "Get a single expense" },
    { "name": "create_expense", "description": "Create a new expense" },
    { "name": "delete_expense", "description": "Delete an expense" },
    { "name": "record_expense_payment", "description": "Record payment on an expense" },
    { "name": "record_payment", "description": "Record payment on any document type" },
    { "name": "get_business_info", "description": "Get company/business information" },
    { "name": "get_bank_accounts", "description": "List configured bank accounts" }
  ]
}
